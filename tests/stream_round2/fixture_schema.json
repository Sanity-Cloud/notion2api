    "base_commit": {"type": "string"}, "parser_version": {"type": "string"},
    "physical_fragments": {"type": "array"}, "raw_bytes": {"type": "integer", "minimum": 0},
    "logical_chunks": {"type": "array"}, "expected_outcome": {"type": "string"},
